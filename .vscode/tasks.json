{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mkosi: build image",
            "type": "shell",
            "command": "mkosi --auto-bump --force",
            "group": "build",
        },
        {
            "label": "systemd-repart: burn image",
            "type": "shell",
            "command": "systemd-repart --offline=yes --empty=force --dry-run=no --definitions=/ --copy-from=mkosi.output/ParticleOS_*_x86-64 /dev/sda"
        }
    ]
}